{
  "name": "cloudcall-sdk",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cloudcall/playground dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:server": "node --test server/app.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @cloudcall/playground build --mode demo && playwright test",
    "test:production": "pnpm --filter @cloudcall/playground build --mode production --outDir dist-production && playwright test --config playwright.production.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "benchmark": "vitest bench --run",
    "changeset": "changeset",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:server && pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue": "^3.5.22"
  }
}
